{
  "name": "atlantasim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Top-down open-world driving game on the real streets of Atlanta ITP (OpenStreetMap data)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:fetch": "python3 tools/fetch_overture.py",
    "data:build": "python3 tools/build_world.py"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
